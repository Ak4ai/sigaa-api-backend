NODE_ENV=development
# development  → Windows local (Chrome abre visível)
# vps          → Linux VPS / Oracle Cloud / DigitalOcean (Chrome via apt)
# production   → Vercel serverless (@sparticuz/chromium)

# Segredo para JWT (pode ser qualquer string)
SECRET=seu_segredo_jwt_aqui

# Exatamente 32 caracteres para AES-256 (senha do aluno)
ENC_SECRET=SuaChaveAES256_Senha_32chars!!!!

# Exatamente 32 caracteres para AES-256 (usuário/CPF do aluno)
ENC_SECRET_USER=SuaChaveAES256_User__32chars!!!!

# (Opcional) Caminho do Chrome no Linux — detectado automaticamente se não definido
# CHROME_PATH=/usr/bin/chromium-browser

# Credenciais SIGAA — usadas APENAS pelo script standalone extrai-frequencia-standalone.js
# O servidor (api/scraper.js) recebe user/pass via body da requisição POST /api/scraper
# SIGAA_USER=sua_matricula
# SIGAA_PASSWORD=sua_senha

# Chave API do Gemini (necessária para interpretação do PDF do calendário)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Revogações: na VPS/local, manter este diretório em disco persistente.
# TOKEN_REVOCATION_DIR=/var/lib/sigaa/token-revocations
# Para Vercel ou servidores sem disco compartilhado, configurar Redis REST:
# UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_redis

# Proteção de consultas (valores padrão; limites por IP e processo Node):
# LOGIN_RATE_LIMIT=20          # em 10 minutos
# SCRAPER_RATE_LIMIT=30        # em 10 minutos
# API_RATE_LIMIT=3000          # em 1 minuto, incluindo polling
# SCRAPER_QUEUE_LIMIT=10       # pedidos em espera, além de 1 em execução
# SCRAPER_TOTAL_TIMEOUT_MS=150000
# SCRAPER_RUNTIME_TIMEOUT_MS=120000
# HOST=127.0.0.1              # padrão; Nginx local faz o proxy
# TRUST_PROXY=loopback         # confiar somente no proxy local
